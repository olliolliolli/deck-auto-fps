#!/bin/bash
# AutoFPS — обгортка запуску гри.
# Параметр запуску в Steam:  ~/.local/bin/autofps-launch %command%
# (лаунчер створює плагін; він викликає цей файл, а якщо плагін видалено — просто гру)
#
# 1) автоматично налаштовує графіку гри (самонавчання між запусками)
# 2) вмикає невидимий лог MangoHud, з якого плагін бере FPS
# 3) підключає фрейм-генерацію lsfg-vk з керованим плагіном профілем
#
# Головне правило: гра має запуститися ЗА БУДЬ-ЯКИХ умов. Тому:
#  - конфіг lsfg-vk перевіряється перед запуском (lsfg-vk-cli validate);
#  - якщо гра впала в перші секунди, наступний запуск іде в безпечнішому режимі:
#      full → nolsfg (без генерації кадрів) → safe (без MangoHud, lsfg і змін графіки);
#  - кожен крок пишеться в ~/.cache/autofps/wrapper.log.

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
CACHE="$HOME/.cache/autofps"
CFG="$HOME/.config/autofps"
LOG="$CACHE/wrapper.log"
mkdir -p "$CACHE/logs" "$CFG" 2>/dev/null

log() { echo "[$(date '+%F %T')] $*" >>"$LOG" 2>/dev/null; }

# лог не росте безмежно
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 300000 ]; then
  tail -n 400 "$LOG" >"$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
fi

APPID="${SteamAppId:-${SteamGameId:-0}}"
FAST_EXIT="${AUTOFPS_FAST_EXIT:-20}"   # гра, що закрилась швидше — вважається такою, що впала на старті

log "=== Запуск гри appid=$APPID"
log "команда: $(printf '%q ' "$@" | cut -c1-700)"

# --- режим для цієї гри (понижується після падінь на старті)
MODE_FILE="$CFG/mode_$APPID"
MODE="$(cat "$MODE_FILE" 2>/dev/null)"
case "$MODE" in full|nolsfg|safe) ;; *) MODE=full ;; esac
log "режим: $MODE"

find "$CACHE/logs" -name '*.csv' -mtime +2 -delete 2>/dev/null

# --- автопідбір графіки (не в безпечному режимі: зміни конфігів теж можуть бути причиною)
rm -f "$CACHE/tuning_now" 2>/dev/null
if [ "$MODE" != "safe" ] && [ -f "$DIR/autotune.py" ]; then
  timeout 15 python3 "$DIR/autotune.py" "$APPID" "$@" >>"$LOG" 2>&1 \
    || log "autotune завершився з помилкою (ігнорую)"
fi
TUNING="$(cat "$CACHE/tuning_now" 2>/dev/null)"

# --- OptiScaler («DLSS» для AMD): перевірити файли в грі (після оновлення гри/OptiScaler
#     перевстановлюється сам) і сказати Wine брати підмінну бібліотеку з теки гри
OPTI_DLL=""; OPTI_FG=0; OPTI_METHOD=""
if [ "$MODE" != "safe" ] && [ -f "$DIR/optiscaler.py" ]; then
  OPTI_OUT="$(timeout 120 python3 "$DIR/optiscaler.py" ensure "$APPID" "$@" 2>>"$LOG")"
  OPTI_DLL="$(echo "$OPTI_OUT" | sed -n 's/^DLL=//p')"
  OPTI_FG="$(echo "$OPTI_OUT" | sed -n 's/^FG=//p')"
  OPTI_METHOD="$(echo "$OPTI_OUT" | sed -n 's/^METHOD=//p')"
  # додаткові змінні (напр. FSR_WATERMARK=1 — напис AMD про модель FSR 4); лише безпечні імена
  while IFS= read -r kv; do
    case "$kv" in
      FSR_WATERMARK=*) export "$kv"; log "env: $kv" ;;
    esac
  done < <(echo "$OPTI_OUT" | sed -n 's/^ENV=//p')
fi
if [ -n "$OPTI_DLL" ]; then
  export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}${OPTI_DLL}=n,b"
fi
if [ "$OPTI_METHOD" = "direct" ]; then
  export SteamDeck=0
  log "FSR 4 «один файл» у вбудований FSR 3.1 гри${OPTI_DLL:+ (override ${OPTI_DLL}=n,b)}"
elif [ -n "$OPTI_DLL" ]; then
  export SteamDeck=0   # деякі ігри на «Steam Deck» ховають DLSS/FSR
  log "OptiScaler увімкнено: ${OPTI_DLL}=n,b (власна генерація кадрів: $OPTI_FG)"
fi

# --- MangoHud: невидимий лог FPS кожні 250 мс
USE_MANGO=0
if [ "$MODE" != "safe" ]; then
  if command -v mangohud >/dev/null 2>&1; then
    USE_MANGO=1
    export MANGOHUD=1
    export MANGOHUD_CONFIG="autostart_log=1,log_interval=250,log_duration=0,output_folder=$CACHE/logs,alpha=0.0,background_alpha=0.0"
  else
    log "mangohud не знайдено — FPS не вимірюватиметься"
  fi
fi

# --- генерація кадрів: вирішується ПРИ ЗАПУСКУ (у lsfg-vk v2 множник 1 — невалідний,
#     тож вимкнути генерацію посеред гри не можна, лише змінити множник)
FG_MODE="$(cat "$CFG/fg_mode" 2>/dev/null)"; [ -n "$FG_MODE" ] || FG_MODE=auto
FG_SAVED="$(cat "$CFG/fg_$APPID" 2>/dev/null)"
LSFG_VER="$(cat "$CFG/lsfg_version" 2>/dev/null)"
LSFG_CONF="$CFG/lsfg-vk.toml"
WANT=0
if [ "$OPTI_FG" = "1" ]; then
  log "генерацію кадрів робить OptiScaler — lsfg-vk у цій грі не вмикаю"
elif [ "$MODE" = "full" ] && [ "$FG_MODE" = "always" ]; then
  # «Завжди» — явний вибір користувача: генерація навіть під час підбору графіки
  # (плагін ділить FPS MangoHud на множник, тож замір лишається приблизно чесним)
  case "$FG_SAVED" in 2|3|4) WANT="$FG_SAVED" ;; *) WANT=2 ;; esac
elif [ "$MODE" = "full" ] && [ "$FG_MODE" != "off" ] && [ "$TUNING" != "1" ]; then
  case "$FG_SAVED" in 2|3|4) WANT="$FG_SAVED" ;; esac
fi
[ "$TUNING" = "1" ] && [ "$FG_MODE" != "always" ] && log "графіка цієї гри ще підбирається — запуск без генерації кадрів (для чесного заміру; «Генерація: завжди» вмикає її й зараз)"

FG_WANT="$WANT"
USE_LSFG=0
if [ "$WANT" -ge 2 ] && [ -f "$LSFG_CONF" ]; then
  sed -i "s/^multiplier = .*/multiplier = $WANT/" "$LSFG_CONF" 2>/dev/null
  if [ "$LSFG_VER" = "2" ]; then
    CLI="$HOME/.local/bin/lsfg-vk-cli"
    if [ -x "$CLI" ]; then
      if OUT="$(timeout 10 "$CLI" validate --config "$LSFG_CONF" --print 2>&1)"; then
        case "$OUT" in
          *"The DLL file does not exist"*|*"DLL override: (none)"*)
            log "DLL для lsfg-vk не знайдено — генерацію кадрів вимкнено: $(echo "$OUT" | tr '\n' ' ' | cut -c1-300)" ;;
          *) USE_LSFG=1 ;;
        esac
      else
        log "конфіг lsfg-vk не пройшов перевірку — генерацію кадрів вимкнено: $(echo "$OUT" | tr '\n' ' ' | cut -c1-400)"
      fi
    else
      log "lsfg-vk-cli не знайдено — генерацію кадрів не вмикаю"
    fi
  elif [ "$LSFG_VER" = "1" ]; then
    USE_LSFG=1   # у v1 немає інструмента перевірки; від падіння страхує безпечний режим
  else
    log "lsfg-vk не знайдено — генерацію кадрів не вмикаю"
  fi
fi

if [ "$USE_LSFG" = 1 ] && [ "$LSFG_VER" = "2" ]; then
  export LSFGVK_CONFIG="$LSFG_CONF"
  export LSFGVK_PROFILE="autofps"
elif [ "$USE_LSFG" = 1 ]; then
  export LSFG_CONFIG="$LSFG_CONF"
  export LSFG_PROCESS="autofps"
  export ENABLE_LSFG=1
else
  # не даємо чужим налаштуванням lsfg-vk увімкнутись поверх наших
  export DISABLE_LSFGVK=1
  WANT=0
fi
log "mangohud=$USE_MANGO lsfg=$USE_LSFG (v${LSFG_VER:-?}, ×$WANT, режим FG: $FG_MODE)"

printf '{"appid":"%s","pid":%d,"started":%d,"mode":"%s","mangohud":%d,"lsfg":%d,"fg":%d,"fg_want":%d,"opti":"%s","opti_fg":%d,"opti_method":"%s"}\n' \
  "$APPID" "$$" "$(date +%s)" "$MODE" "$USE_MANGO" "$USE_LSFG" "$WANT" "$FG_WANT" "$OPTI_DLL" "${OPTI_FG:-0}" "$OPTI_METHOD" >"$CACHE/current.json"

# --- запуск (дочірнім процесом, щоб знати, чи гра не впала одразу)
START=$(date +%s)
if [ "$USE_MANGO" = 1 ]; then
  mangohud "$@"
else
  "$@"
fi
RC=$?
DUR=$(( $(date +%s) - START ))
log "гра завершилась через ${DUR} с, код $RC"

if [ "$DUR" -lt "$FAST_EXIT" ]; then
  case "$MODE" in
    full)   NEXT=nolsfg ;;
    nolsfg) NEXT=safe ;;
    *)      NEXT=safe ;;
  esac
  if [ "$NEXT" != "$MODE" ]; then
    echo "$NEXT" >"$MODE_FILE"
    log "гра закрилась за ${DUR} с — наступний запуск у режимі $NEXT"
  fi
  printf '{"appid":"%s","t":%d,"from":"%s","to":"%s","dur":%d,"rc":%d}\n' \
    "$APPID" "$(date +%s)" "$MODE" "$NEXT" "$DUR" "$RC" >"$CACHE/last_crash.json"
fi
exit $RC
